{
  "name": "rnx-cad",
  "productName": "Rnx CAD",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base ./",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-packager . RnxCAD --platform=win32 --out=release --overwrite --asar --icon=public/favicon.ico --ignore=\"^/(src|public|release|node_modules|index.html|package-lock.json|README.md)(/|$)\""
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "electron": "45.3.3",
    "lucide-static": "1.73.0",
    "manifold-3d": "3.5.5",
    "three": "0.187.0",
    "vite": "8.3.8"
  }
}
